# ──────────────────────────────────────────
# FashionEcom — Environment Variables
# Copy this file to .env and fill in values
# ──────────────────────────────────────────

# ── MySQL ────────────────────────────────
MYSQL_ROOT_PASSWORD=fashionecom_root
MYSQL_PASSWORD=fashionecom_dev
DB_HOST=mysql
DB_PORT=3306
DB_USERNAME=fashionecom
DB_PASSWORD=fashionecom_dev
DB_NAME=fashion_ecom

# ── Redis ────────────────────────────────
REDIS_HOST=redis
REDIS_PORT=6379

# ── Auth (JWT) ───────────────────────────
JWT_SECRET=change-me-to-a-long-random-secret-min-32-chars
JWT_EXPIRATION=900
REFRESH_TOKEN_EXPIRATION=604800

# ── Storage (Local) ─────────────────────
STORAGE_PATH=./storage
# Migrate to R2 later:
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_ENDPOINT=
# R2_BUCKET_NAME=fashionecom-public
# R2_PUBLIC_URL=

# ── Payment Gateways ────────────────────
# MoMo
MOMO_PARTNER_CODE=
MOMO_ACCESS_KEY=
MOMO_SECRET_KEY=

# VNPAY
VNPAY_TMN_CODE=
VNPAY_HASH_SECRET=

# Payoo
PAYOO_MERCHANT_ID=
PAYOO_API_KEY=
PAYOO_SECRET=

# ZaloPay
ZALOPAY_APP_ID=
ZALOPAY_KEY1=
ZALOPAY_KEY2=

# ── Shipping ─────────────────────────────
# GHN
GHN_API_KEY=
GHN_SHOP_ID=

# GHTK
GHTK_API_KEY=

# ── Mail ─────────────────────────────────
RESEND_API_KEY=
ADMIN_EMAIL=admin@fashionecom.vn

# ── Search (Phase 5) ────────────────────
MEILISEARCH_HOST=http://meilisearch:7700
MEILISEARCH_API_KEY=

# ── ISR Revalidation ────────────────────
REVALIDATE_SECRET=change-me-to-a-random-secret
NEXT_REVALIDATE_URL=http://frontend:3000

# ── Frontend ─────────────────────────────
NEXT_PUBLIC_API_URL=/api
NEXT_PUBLIC_SITE_URL=http://localhost:3300

# ── Dev Ports (tranh xung dot shared VPS) ─
# Frontend: 3300 (WebPhoto: 3000, VietNet: 3100, LeQuyDon: 3200)
# Backend:  4300 (WebPhoto: 4000, VietNet: 4100, LeQuyDon: 4200)
# MySQL:    3309 (WebPhoto: 3306, VietNet: 3307, LeQuyDon: 3308)
# Redis:    6382 (WebPhoto: 6379, VietNet: 6380, LeQuyDon: 6381)

# ── Backup ───────────────────────────────
MYSQL_BACKUP_PASSWORD=fashionecom_dev
