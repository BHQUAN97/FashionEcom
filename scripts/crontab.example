# ──────────────────────────────────────────
# FashionEcom — System crontab (/etc/cron.d/fashionecom)
# Install: sudo cp /opt/fashionecom/scripts/crontab.example /etc/cron.d/fashionecom
#          sudo chmod 644 /etc/cron.d/fashionecom
# Schedule offset (tránh xung đột VietNet 2:00, LeQuyDon 2:30):
#   Backup: 2:45 AM | Docker cleanup: Sun 4:00 AM
# ──────────────────────────────────────────

SHELL=/bin/bash
PATH=/usr/local/sbin:/usr/local/bin:/sbin:/bin:/usr/sbin:/usr/bin

# MySQL backup — daily 2:45 AM (offset: VietNet=2:00, LeQuyDon=2:30, FashionEcom=2:45)
45 2 * * * root /opt/fashionecom/scripts/backup-mysql.sh >> /var/log/fashionecom/backup.log 2>&1

# Docker cleanup — weekly Sunday 4:00 AM (offset: VietNet=3:00, LeQuyDon=3:30, FashionEcom=4:00)
0 4 * * 0 root /opt/fashionecom/scripts/docker-cleanup.sh >> /var/log/fashionecom/docker-cleanup.log 2>&1
